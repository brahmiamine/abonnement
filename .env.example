# Copier vers .env.local pour cibler un autre projet Supabase (dev, staging…).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=votre-cle-anon-publique

# Notifications push (application fermée). Générer la paire de clés : npx web-push generate-vapid-keys
# Seule la clé PUBLIQUE va ici ; la privée reste dans les secrets de la fonction send-reminders.
VITE_VAPID_PUBLIC_KEY=
